# 環境與金鑰
.env
*.env
# .env 備份 / 變體（避免 `.env.env.bak.*` 這類檔名再次 commit 進去）
*.env.*
!*.env.example
!liff/.env.liff.example

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/

# 向量資料庫（體積大）
PTT-Crawler-master/chroma_db/
ptt_vector_db/

# 語料（大型資料）
*.jsonl
data/
# LINE 群組匯出聊天記錄（私人資料，體積大）
[[]LINE[]]*.txt
raw_message/

# 日誌
bot.log
nohup.out

# 其他
*.json
!liff/*.json
!seed/*.json
Taiba/
Taiba
.DS_Store
ngrok.yml

# Git worktrees
.worktrees/

# LIFF frontend
liff/node_modules/
liff/dist/
liff/.env.local
liff/.env.liff
